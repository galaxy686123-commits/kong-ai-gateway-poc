# ─────────────────────────────────────────────────────────────
#  Kong AI Gateway PoC 환경 설정
#  cp .env.example .env  후 값을 채우세요. .env 는 git 에 올라가지 않습니다.
#  값 뒤에 설명(# …)을 붙이지 마세요 — 값의 일부로 읽힐 수 있습니다.
# ─────────────────────────────────────────────────────────────

# ── 비밀번호 (반드시 변경) ─────────────────────────────────────
KONG_PG_PASSWORD=change-me-db
# Kong Manager 로그인(kong_admin) 및 Admin API 토큰
KONG_ADMIN_PASSWORD=change-me-admin
# Kong Manager 세션 서명용 임의 문자열
KONG_SESSION_SECRET=change-me-session

# ── Kong Enterprise 라이선스 ───────────────────────────────────
# secrets/license.json 에 두면 자동으로 읽습니다. (파일은 git 에 올라가지 않음)
LICENSE_FILE=./secrets/license.json

# ── 채팅 모델 (OpenAI 호환) ────────────────────────────────────
DECK_CHAT_URL=http://llm.example.internal/v1/chat/completions
DECK_CHAT_MODEL=your-chat-model
# 업스트림 인증 헤더 값 전체. 인증이 없으면 아무 값이나 두면 됩니다.
LLM_AUTH_HEADER=Bearer none

# ── 임베딩 모델 (시맨틱 캐시용, 없으면 비워 두기) ──────────────
DECK_EMBED_URL=
DECK_EMBED_MODEL=
DECK_EMBED_DIMS=1024
EMBED_AUTH_HEADER=Bearer none

# ── 게이트웨이 사용자 키 ───────────────────────────────────────
# 클라이언트는 요청 헤더 `apikey: <이 값>` 으로 호출합니다.
DECK_CLIENT_KEY=change-me-client-key

# ── 한국어 PII 가드 (addons/pii-guard/app.py 가 있을 때만 사용) ──
# true 면 문맥 판정에 채팅 모델 사용
PII_LLM_ENABLED=false
PII_LLM_URL=
PII_LLM_MODEL=

# ── 브라우저에서 Kong Manager 에 접속할 주소 ───────────────────
# 파드 밖에서 접속하면 그 주소로 바꾸세요. (Manager 는 브라우저가 Admin API 를 직접 호출)
MANAGER_URL=http://localhost:8002
ADMIN_API_URL=http://localhost:8001

# ── 포트 ──────────────────────────────────────────────────────
PROXY_PORT=8000
ADMIN_PORT=8001
MANAGER_PORT=8002

# ── 데이터 보존 ───────────────────────────────────────────────
# 비워 두면 도커 볼륨에 저장. 파드 재시작 후에도 남는 경로가 있으면 지정 (예: /home/user/kong-data)
PG_DATA_DIR=

# 요청 로그 경로. 비워 두면 도커 볼륨(kong-poc-logs)에 저장
LOG_DIR=

# ── 직접 설치 방식 (docker 없는 파드 · native/*.sh) ────────────
# 주피터 주소 — 브라우저 주소창의 https://… 부분 (끝의 / 와 /lab… 은 빼고).
# 지정하면 Kong Manager 를 <주피터 주소>/proxy/absolute/8002/ 로 엽니다 (jupyter-server-proxy).
JUPYTER_URL=
# 설치 파일 저장소를 clone 한 곳. 비워 두면 이 폴더 옆의 kong-ai-gateway-poc-pkgs
PKGS_DIR=
# DB·로그를 둘 곳. 파드를 다시 만들어도 남는 경로여야 합니다. 비워 두면 이 폴더 안 data/
DATA_DIR=
PG_PORT=5432
# 8080 은 개발환경이 이미 쓰는 경우가 있어 피함
PII_PORT=18080
# nginx worker 수 = 쓸 CPU 수
KONG_WORKERS=2

# ── 이미지 (보통 변경 불필요) ──────────────────────────────────
KONG_IMAGE=kong/kong-gateway:3.15
PG_IMAGE=pgvector/pgvector:pg16
DECK_IMAGE=kong/deck:v1.65.1
PY_IMAGE=python:3.12-slim
