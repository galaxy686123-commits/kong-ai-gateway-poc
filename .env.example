# ─────────────────────────────────────────────────────────────
#  Kong AI Gateway PoC 환경 설정
#  cp .env.example .env  후 값을 채우세요. .env 는 git 에 올라가지 않습니다.
#  값 뒤에 설명(# …)을 붙이지 마세요 — 값의 일부로 읽힐 수 있습니다.
#  비밀번호·키에는 영문·숫자·-·_ 만 쓰세요.
# ─────────────────────────────────────────────────────────────

# ── 비밀번호·키 (반드시 변경) ──────────────────────────────────
KONG_PG_PASSWORD=change-me-db
# Kong Manager 로그인(kong_admin) 및 Admin API 토큰. 첫 설치 뒤에는 바꾸지 마세요
KONG_ADMIN_PASSWORD=change-me-admin
# Kong Manager 화면에서 로그인 비밀번호를 바꿨다면 새 비밀번호 (verify.sh 의 로그인 점검용, 비우면 위 값).
# Manager 에서 바꿔도 스크립트가 쓰는 Admin API 토큰은 위 KONG_ADMIN_PASSWORD 그대로이니 위 값은 고치지 마세요
KONG_MANAGER_PASSWORD=
# Kong Manager 세션 서명용 임의 문자열
KONG_SESSION_SECRET=change-me-session
# 게이트웨이 사용자 키 (team-a). 클라이언트는 요청 헤더 `apikey: <이 값>` 으로 호출
DECK_CLIENT_KEY=change-me-client-key
# team-b 사용자 키 — 비워 두면 apply-config.sh 가 만들어 여기에 적는다
DECK_CLIENT_KEY_B=

# ── 브라우저에서 Kong Manager 를 여는 방법 (둘 중 하나) ──────────
# ① 플랫폼이 8001·8002 포트를 밖으로 열어 준 경우: 그 주소를 넣고 JUPYTER_URL 은 비워 둔다
#    (브라우저가 Admin API 를 직접 부르므로 두 주소 모두 필요)
#    환경마다(빌드할 때마다) 주소 속 ID 가 바뀌면 그 자리를 {ENV_ID} 로 — Manager 를 연 주소에서 요청마다 맞춘다
#    예) MANAGER_URL=https://manager-{ENV_ID}.service.example.com · ADMIN_API_URL=https://adminapi-{ENV_ID}.service.example.com
MANAGER_URL=http://localhost:8002
ADMIN_API_URL=http://localhost:8001
# ② 주피터를 거쳐 여는 경우: 주피터 주소 (https://… 까지, 끝의 / 와 /lab… 은 빼고). 넣으면 ① 보다 우선
JUPYTER_URL=

# ── Kong Enterprise 라이선스 ───────────────────────────────────
# 없으면 Kong 이 읽기 전용으로 떠서 설치·접속 시험만 됩니다 (설정 적용 불가)
# 넣기: bash set-license.sh <받은 파일>. 유지 폴더를 지정하면 <유지 폴더>/kong-poc/secrets/license.json 에 둡니다
LICENSE_FILE=./secrets/license.json

# ── 사내 LLM (OpenAI 호환) — 통합 경로·x-ai-target: internal ────
DECK_CHAT_URL=http://llm.example.internal/v1/chat/completions
DECK_CHAT_MODEL=your-chat-model
# 업스트림 인증 헤더 값 전체 ("Bearer …" 까지). 인증이 없으면 아무 값이나
LLM_AUTH_HEADER=Bearer none

# ── 외부 LLM = 두 번째 LLM (OpenAI 호환, 선택) — x-ai-target: external ──
# 넣으면 통합 경로의 장애 대체 대상이 되고(아래 FALLBACK=auto), 요청의 model 이 이 이름이면 이 LLM 을 고른다
# (DECK_CHAT_MODEL 이름이면 사내 LLM). 사내망 LLM 이어도 이 자리에 넣으면 된다.
DECK_EXT_URL=
DECK_EXT_MODEL=
EXT_AUTH_HEADER=Bearer none

# ── 세 번째부터 LLM (OpenAI 호환, 선택) — 요청의 model 이 이 이름이면 이 LLM 을 고른다 ──
# 번호를 늘려 계속 추가한다 (DECK_LLM4_… · LLM4_AUTH_HEADER …). 키를 넣었으면 Kong 을 다시 띄운 뒤 적용 (빌드 불필요)
# DECK_LLM3_URL=https://llm3.example.internal/v1/chat/completions
# DECK_LLM3_MODEL=your-third-model
# LLM3_AUTH_HEADER=Bearer none

# ── Azure OpenAI (선택) — x-ai-target: azure ──────────────────
DECK_AZURE_INSTANCE=
DECK_AZURE_DEPLOYMENT=
DECK_AZURE_API_VERSION=2024-06-01
AZURE_API_KEY=
# ── GCP Vertex AI Gemini (선택) — x-ai-target: gcp ────────────
DECK_GCP_PROJECT=
DECK_GCP_LOCATION=asia-northeast3
DECK_GCP_MODEL=
# 서비스 계정 키 JSON 을 한 줄로
GCP_SERVICE_ACCOUNT_JSON=
# ── AWS Bedrock (선택) — x-ai-target: aws ─────────────────────
DECK_AWS_REGION=
DECK_AWS_MODEL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 통합 경로의 장애 대체(1-4) 대상: auto(외부 LLM 이 있으면 그쪽) · azure · none
FALLBACK=auto

# ── 통합 경로 /v1/chat/completions 기능 스위치 (on/off) ─────────
FEATURE_MASKING=on
FEATURE_ACL=on
FEATURE_RATE_LIMIT=on
FEATURE_TOKEN_LIMIT=on
FEATURE_PROMPT_GUARD=on
# 아래 둘은 답변을 다 받아 검사·수정하므로 켜면 스트리밍이 꺼진다
FEATURE_OUTPUT_GUARD=off
FEATURE_OUTPUT_MASK=off
# 임베딩 모델이 있을 때만
FEATURE_SEMANTIC_GUARD=off
FEATURE_SEMANTIC_CACHE=off
# 영역별 시험 경로(/poc/1~4)가 부를 LLM: mock(모의 LLM — 결과가 늘 같음) · llm(사내 LLM)
FEATURE_UPSTREAM=mock

# ── 한도·정책 ─────────────────────────────────────────────────
# 사용자(키)별 분당·일일 호출 수, 분당 토큰
DECK_RPM=60
DECK_RPD=5000
DECK_TPM=20000
# 외부 LLM 으로 보내면 안 되는 기밀 키워드 (정규식)
DECK_DLP_PATTERN=(?i)(?:대외비|기밀|사내\s*한정|confidential)
# 유해 답변 대신 보여 줄 문구
DECK_BLOCK_MESSAGE=보안 정책에 따라 표시할 수 없습니다.
# 답변에서 막을 유해 표현 (쉼표로 구분, 비우면 기본 목록)
PII_HARMFUL_WORDS=

# ── OCR · Agent (비우면 시험용 모의 서버) ───────────────────────
DECK_OCR_URL=
DECK_OCR_MAX_MB=50
DECK_AGENT_A_URL=
DECK_AGENT_B_URL=

# ── 사내 SSO (OIDC, 선택) — /sso/v1/chat/completions ──────────
DECK_OIDC_ISSUER=
DECK_OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── 중앙 로그·분산 추적 (선택) ─────────────────────────────────
# 요청 로그를 보낼 HTTP 주소 (ELK·Splunk HEC·수집기)
DECK_LOG_HTTP_URL=
# OTLP/HTTP 추적 수집 주소 (예: http://<수집기>:4318/v1/traces)
DECK_OTEL_ENDPOINT=

# ── 임베딩 모델 (의미 기반 가드·시맨틱 캐시용, 선택) ────────────
DECK_EMBED_URL=
DECK_EMBED_MODEL=
DECK_EMBED_DIMS=1024
EMBED_AUTH_HEADER=Bearer none

# ── 한국어 PII 가드 문맥 판정 (선택) ───────────────────────────
PII_LLM_ENABLED=false
PII_LLM_URL=
PII_LLM_MODEL=

# ── 포트·경로 (보통 그대로) ────────────────────────────────────
PROXY_PORT=8000
ADMIN_PORT=8001
MANAGER_PORT=8002
STATUS_PORT=8100
PG_PORT=5432
PII_PORT=18080
MOCK_PORT=18090
# nginx worker 수 = 쓸 CPU 수
KONG_WORKERS=2
# 설치 파일(Kong .deb · decK) 위치. 비워 두면 이 저장소의 pkgs/
PKGS_DIR=
# DB·로그·백업·점검 기록을 둘 곳 (비우면 이 저장소 안 data/). 파드를 다시 만들어도 남는 경로여야 합니다.
# 유지 폴더(PV)가 따로 있으면 직접 쓰지 말고  bash set-data-dir.sh <유지 폴더>  로 지정하세요 (옮기기까지 해 줌)
#   지정하면 이 설정 전체가 <유지 폴더>/kong-poc/settings.env 로 옮겨지고, 여기(.env)에는 위치 한 줄만 남습니다.
#   그 뒤로는 그 파일을 고칩니다:  bash set-env.sh <키> <값>   (빌드해서 저장소 폴더가 읽기 전용이 돼도 바꿀 수 있게)
DATA_DIR=
