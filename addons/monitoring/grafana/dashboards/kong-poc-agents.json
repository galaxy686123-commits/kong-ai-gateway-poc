          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT coalesce(consumer, CASE WHEN end_user IS NOT NULL THEN '최종 사용자(SSO)' END, '(미인증)') AS \"호출 Consumer\", route AS \"대상 에이전트\",\n  count(*) FILTER (WHERE status < 400) AS \"허용\",\n  count(*) FILTER (WHERE status >= 400 AND status < 500) AS \"차단\",\n  count(*) FILTER (WHERE status >= 500) AS \"오류(5xx)\",\n  coalesce(string_agg(DISTINCT a2a_method, ' · '), '') AS \"A2A 메서드\",\n  max(ts) AS \"최근 호출\"\nFROM requests WHERE $__timeFilter(ts) AND route LIKE 'agent-%'\nGROUP BY 1, 2 ORDER BY 1, 2"
        }
      ]
