    {
      "id": 38,
      "type": "nodeGraph",
      "title": "에이전트 호출 관계도",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "description": "노드 = 호출 Consumer · 에이전트 Route · LLM Route(조회 기간에 모델 기록이 있는 Route). 간선 = 호출(허용 · 차단(4xx) · 오류(5xx) 건수), 색상: 녹색 전체 허용 · 주황 일부 차단 · 오류 · 적색 전체 차단 · 오류. LLM Route 는 에이전트 Consumer 의 호출만 표시. 에이전트 Consumer 와 같은 이름의 에이전트 Route 는 하나의 노드로 표시. 키 없이 SSO 토큰으로만 호출한 경우 「최종 사용자(SSO)」, 키 · 토큰이 모두 없는 경우 「(미인증)」. 노드 수치 = 수신 · 발신 건수",
      "options": {
        "layoutAlgorithm": "layered",
        "zoomMode": "cooperative",
        "nodes": {},
        "edges": {}
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "WITH llm AS (SELECT DISTINCT route FROM requests WHERE $__timeFilter(ts) AND model IS NOT NULL AND route IS NOT NULL)\n, e AS (\n  SELECT coalesce(consumer, CASE WHEN end_user IS NOT NULL THEN '최종 사용자(SSO)' END, '(미인증)') AS src, route AS dst,\n    count(*) FILTER (WHERE status < 400) AS ok, count(*) FILTER (WHERE status >= 400) AS bad\n  FROM requests WHERE $__timeFilter(ts) AND (route LIKE 'agent-%' OR (consumer LIKE 'agent-%' AND route IN (SELECT route FROM llm)))\n  GROUP BY 1, 2)\n, n AS (SELECT src AS id FROM e UNION SELECT dst FROM e)\nSELECT n.id AS id, CASE WHEN n.id IN (SELECT route FROM llm) AND n.id NOT LIKE 'agent-%' THEN 'LLM · ' || n.id ELSE n.id END AS title,\n  CASE WHEN n.id LIKE 'agent-%' THEN '에이전트' WHEN n.id IN (SELECT route FROM llm) THEN 'LLM Route' ELSE '호출 주체' END AS subtitle,\n  '수신 ' || coalesce((SELECT sum(ok + bad) FROM e WHERE e.dst = n.id), 0) AS mainstat,\n  '발신 ' || coalesce((SELECT sum(ok + bad) FROM e WHERE e.src = n.id), 0) AS secondarystat,\n  CASE WHEN n.id LIKE 'agent-%' THEN '#1e96cf' WHEN n.id IN (SELECT route FROM llm) THEN '#8e5bd6' ELSE '#8a8f98' END AS color\nFROM n"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "B",
          "rawSql": "WITH llm AS (SELECT DISTINCT route FROM requests WHERE $__timeFilter(ts) AND model IS NOT NULL AND route IS NOT NULL)\n, e AS (\n  SELECT coalesce(consumer, CASE WHEN end_user IS NOT NULL THEN '최종 사용자(SSO)' END, '(미인증)') AS src, route AS dst,\n    count(*) FILTER (WHERE status < 400) AS ok, count(*) FILTER (WHERE status >= 400) AS bad,\n    count(*) FILTER (WHERE status >= 400 AND status < 500) AS blk, count(*) FILTER (WHERE status >= 500) AS err\n  FROM requests WHERE $__timeFilter(ts) AND (route LIKE 'agent-%' OR (consumer LIKE 'agent-%' AND route IN (SELECT route FROM llm)))\n  GROUP BY 1, 2)\nSELECT src || ' → ' || dst AS id, src AS source, dst AS target,\n  '허용 ' || ok AS mainstat, concat_ws(' · ', CASE WHEN blk > 0 THEN '차단 ' || blk END, CASE WHEN err > 0 THEN '오류 ' || err END) AS secondarystat,\n  CASE WHEN ok = 0 THEN '#d44a3a' WHEN bad > 0 THEN '#e08a1e' ELSE '#3f9b4f' END AS color,\n  least(1 + (ok + bad) / 5.0, 6) AS thickness\nFROM e"
        }
      ],
      "gridPos": {
        "h": 11,
        "w": 16,
        "x": 0,
        "y": 9
      },
      "transformations": [
        {
          "id": "organize",
          "filter": {
            "id": "byRefId",
            "options": "A"
          },
          "options": {
            "renameByName": {
              "mainstat": "수신",
              "secondarystat": "발신",
              "color": "색상(파랑 에이전트 · 보라 LLM · 회색 호출 주체)"
            }
          }
        }
      ]
    },
