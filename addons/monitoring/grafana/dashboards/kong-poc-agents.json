        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT coalesce(consumer, '(Consumer 없음)') AS \"호출 Consumer\", end_user AS \"최종 사용자(SSO)\", coalesce(route, '-') AS \"Route\",\n  count(*) AS \"호출\", count(*) FILTER (WHERE status < 400) AS \"허용\", count(*) FILTER (WHERE status >= 400 AND status < 500) AS \"차단\", count(*) FILTER (WHERE status >= 500) AS \"오류(5xx)\",\n  coalesce(sum(total_tokens), 0) AS \"토큰\", max(ts) AS \"최근 호출\"\nFROM requests WHERE $__timeFilter(ts) AND end_user IS NOT NULL\nGROUP BY 1, 2, 3 ORDER BY 4 DESC LIMIT 200"
