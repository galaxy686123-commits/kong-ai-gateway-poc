          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT a.name AS \"에이전트\", a.paths AS \"경로(Path)\", a.kind AS \"유형\", a.health AS \"상태\",\n  s.calls AS \"호출 수\", s.err AS \"오류(5xx)\", s.p95 AS \"지연 p95 ms\",\n  (SELECT max(r.ts) FROM requests r WHERE r.route = a.name AND coalesce(r.workspace, 'default') = a.workspace) AS \"최근 호출\",\n  CASE WHEN a.kill_switch THEN '활성(차단 중)' ELSE '비활성' END AS \"긴급 차단\",\n  a.auth AS \"인증 방식\", a.access_rule AS \"접근 정책\", a.callers AS \"호출 허용 Consumer\",\n  coalesce(a.card_name, CASE WHEN a.kind = 'A2A' THEN '(Agent Card 조회 실패) ' || coalesce(a.card_error, '') ELSE '-' END) AS \"Agent Card\",\n  coalesce(a.card_description, '-') AS \"설명\", coalesce(a.card_skills, '-') AS \"Skills\",\n  a.registered_by AS \"등록 방식\", coalesce(a.a2a_logging, '-') AS \"A2A 로깅\", a.targets AS \"Target\", a.workspace AS \"Workspace\", a.updated_at AS \"수집 시각\"\nFROM agents a\nLEFT JOIN LATERAL (\n  SELECT count(*) AS calls, count(*) FILTER (WHERE r.status >= 500) AS err,\n    round((percentile_cont(0.95) WITHIN GROUP (ORDER BY r.latency_ms))::numeric) AS p95\n  FROM requests r WHERE r.route = a.name AND coalesce(r.workspace, 'default') = a.workspace AND $__timeFilter(r.ts)\n) s ON true\nORDER BY a.workspace, a.name"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      }
