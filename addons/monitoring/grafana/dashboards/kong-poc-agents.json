      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kong-poc-prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "(100 * sum_over_time((max by (upstream) (label_replace(kong_upstream_target_health{upstream=~\"agent-.*\", state=\"healthy\"}, \"upstream\", \"$1\", \"upstream\", \"(agent-[^.]+)\\\\..+\")))[$__range:1m]) / sum_over_time((max by (upstream) (label_replace(kong_upstream_target_health{upstream=~\"agent-.*\", state=~\"healthy|unhealthy|dns_error\"}, \"upstream\", \"$1\", \"upstream\", \"(agent-[^.]+)\\\\..+\")))[$__range:1m])) >= 0"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "kong-poc-prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "sum_over_time(((1 - max by (upstream) (label_replace(kong_upstream_target_health{upstream=~\"agent-.*\", state=\"healthy\"}, \"upstream\", \"$1\", \"upstream\", \"(agent-[^.]+)\\\\..+\"))) * max by (upstream) (label_replace(kong_upstream_target_health{upstream=~\"agent-.*\", state=~\"healthy|unhealthy|dns_error\"}, \"upstream\", \"$1\", \"upstream\", \"(agent-[^.]+)\\\\..+\")))[$__range:1m]) and on (upstream) (sum_over_time((max by (upstream) (label_replace(kong_upstream_target_health{upstream=~\"agent-.*\", state=~\"healthy|unhealthy|dns_error\"}, \"upstream\", \"$1\", \"upstream\", \"(agent-[^.]+)\\\\..+\")))[$__range:1m]) > 0)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "kong-poc-prometheus"
          },
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "min by (upstream) (label_replace(kong_upstream_target_health{upstream=~\"agent-.*\", state=\"healthchecks_off\"}, \"upstream\", \"$1\", \"upstream\", \"(agent-[^.]+)\\\\..+\"))"
        }
      ],
