    {
      "id": 7,
      "type": "table",
      "title": "선택 요청 상세(프롬프트 · 응답 전문)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"항목\", \"내용\" FROM (\n  SELECT 1 AS o, '요청' AS \"항목\",\n    format('%s · Workspace %s · 클라이언트 IP %s · 원 IP %s · Consumer %s · 최종 사용자(SSO) %s · Route %s · 모델 %s · 상태 코드 %s · 토큰 %s(입력 %s · 출력 %s) · 지연 %s ms(LLM %s ms · Kong %s ms) · %s %s · 추적 ID %s',\n      to_char(ts AT TIME ZONE 'Asia/Seoul', 'YYYY-MM-DD HH24:MI:SS'), coalesce(workspace, 'default'), coalesce(client_ip, '-'), coalesce(forwarded_for, '-'), coalesce(consumer, '-'), coalesce(end_user, '-'), coalesce(route, '-'), coalesce(model, '-'), status,\n      coalesce(total_tokens::text, '-'), coalesce(prompt_tokens::text, '-'), coalesce(completion_tokens::text, '-'),\n      coalesce(latency_ms::text, '-'), coalesce(llm_latency_ms::text, '-'), coalesce(kong_latency_ms::text, '-'), coalesce(method, ''), coalesce(path, ''), coalesce(correlation_id, '-')) AS \"내용\"\n  FROM requests WHERE request_id = ${rid:sqlstring}\n  UNION ALL\n  SELECT 2, 'A2A', format('%s · 작업 ID %s · 작업 상태 코드 %s', a2a_method, coalesce(a2a_task_id, '-'), coalesce(a2a_task_state, '-')) FROM requests WHERE request_id = ${rid:sqlstring} AND a2a_method IS NOT NULL\n  UNION ALL\n  SELECT 3, '차단 · 오류 사유', error_message FROM requests WHERE request_id = ${rid:sqlstring} AND error_message IS NOT NULL\n  UNION ALL\n  SELECT 4, '프롬프트', coalesce(question, '(기록 없음 - 해당 Target 의 Log payloads 비활성' || CASE WHEN a2a_method IS NOT NULL THEN ' · A2A Route 는 DECK_A2A_LOG_PAYLOADS 설정' ELSE '' END || ')') FROM requests WHERE request_id = ${rid:sqlstring}\n  UNION ALL\n  SELECT 5, '응답', coalesce(answer, '(기록 없음)') FROM requests WHERE request_id = ${rid:sqlstring}\n) x ORDER BY o",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "inspect": true,
            "wrapText": true,
            "cellOptions": {
