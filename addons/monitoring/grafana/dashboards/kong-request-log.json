          "rawQuery": true,
          "rawSql": "SELECT ts AS \"시각\",\n  coalesce(consumer, '-') AS \"사용자\",\n  coalesce(model, '-') AS \"모델\",\n  status AS \"상태\",\n  total_tokens AS \"토큰\",\n  latency_ms AS \"지연 ms\",\n  left(regexp_replace(coalesce(question, ''), '\\s+', ' ', 'g'), 300) AS \"질문\",\n  left(regexp_replace(coalesce(answer, ''), '\\s+', ' ', 'g'), 400) AS \"답변\",\n  request_id\nFROM requests\nWHERE $__timeFilter(ts)\n  AND ('__all' IN (${user:sqlstring}) OR coalesce(consumer, '-') IN (${user:sqlstring}))\n  AND ('__all' IN (${model:sqlstring}) OR coalesce(model, '-') IN (${model:sqlstring}))\n  AND ('${status}' = 'all' OR ('${status}' = 'ok' AND status < 400) OR ('${status}' = 'err' AND status >= 400))\n  AND (${q:sqlstring} = '' OR question ILIKE '%' || ${q:sqlstring} || '%' OR answer ILIKE '%' || ${q:sqlstring} || '%')\nORDER BY ts DESC\nLIMIT 500",
