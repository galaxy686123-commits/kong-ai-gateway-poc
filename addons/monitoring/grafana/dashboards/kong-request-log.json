    {
      "id": 6,
      "type": "table",
      "title": "요청 목록(최근 500건)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "gridPos": {
        "h": 15,
        "w": 24,
