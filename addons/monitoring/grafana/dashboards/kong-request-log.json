      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"시각\",\n  coalesce(consumer, '-') AS \"Consumer\",\n  coalesce(end_user, '-') AS \"최종 사용자(SSO)\",\n  coalesce(route, '-') AS \"Route\",\n  coalesce(workspace, 'default') AS \"Workspace\",\n  coalesce(client_ip, '-') AS \"클라이언트 IP\",\n  coalesce(forwarded_for, '-') AS \"원 IP(XFF)\",\n  coalesce(model, '-') AS \"모델\",\n  status AS \"상태 코드\",\n  coalesce(error_message, '') AS \"차단 · 오류 사유\",\n  coalesce(a2a_method || coalesce(' · ' || a2a_task_state, ''), '') AS \"A2A\",\n  total_tokens AS \"토큰\",\n  latency_ms AS \"지연 ms\",\n  kong_latency_ms AS \"Kong ms\",\n  left(regexp_replace(coalesce(question, ''), '\\s+', ' ', 'g'), 300) AS \"프롬프트\",\n  left(regexp_replace(coalesce(answer, ''), '\\s+', ' ', 'g'), 400) AS \"응답\",\n  coalesce(correlation_id, '') AS \"추적 ID\",\n  request_id\nFROM requests\nWHERE $__timeFilter(ts)\n  AND ('__all' IN (${user:sqlstring}) OR coalesce(consumer, '-') IN (${user:sqlstring}))\n  AND ('__all' IN (${model:sqlstring}) OR coalesce(model, '-') IN (${model:sqlstring}))\n  AND ('__all' IN (${route:sqlstring}) OR coalesce(route, '-') IN (${route:sqlstring}))\n  AND ('${status}' = 'all' OR ('${status}' = 'ok' AND status < 400) OR ('${status}' = 'err' AND status >= 400))\n  AND (${q:sqlstring} = '' OR question ILIKE '%' || ${q:sqlstring} || '%' OR answer ILIKE '%' || ${q:sqlstring} || '%' OR correlation_id = ${q:sqlstring})\nORDER BY ts DESC\nLIMIT 500",
          "refId": "A"
        }
      ],
