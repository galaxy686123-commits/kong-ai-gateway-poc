          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS v\nFROM requests\nWHERE $__timeFilter(ts)\n  AND ('__all' IN (${user:sqlstring}) OR coalesce(consumer, '-') IN (${user:sqlstring}))\n  AND ('__all' IN (${model:sqlstring}) OR coalesce(model, '-') IN (${model:sqlstring}))\n  AND ('__all' IN (${route:sqlstring}) OR coalesce(route, '-') IN (${route:sqlstring}))\n  AND ('${status}' = 'all' OR ('${status}' = 'ok' AND status < 400) OR ('${status}' = 'err' AND status >= 400))\n  AND (${q:sqlstring} = '' OR question ILIKE '%' || ${q:sqlstring} || '%' OR answer ILIKE '%' || ${q:sqlstring} || '%' OR correlation_id = ${q:sqlstring})",
          "refId": "A"
        }
