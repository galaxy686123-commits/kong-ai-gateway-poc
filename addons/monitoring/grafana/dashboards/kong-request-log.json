    {
      "id": 7,
      "type": "table",
      "title": "선택한 요청 — 질문 · 답변 전문 (위 표에서 질문이나 답변을 누르세요)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"항목\", \"내용\" FROM (\n  SELECT 1 AS o, '요청' AS \"항목\",\n    format('%s · 사용자 %s · 모델 %s · 상태 %s · 토큰 %s (질문 %s · 답변 %s) · 지연 %s ms (LLM %s ms) · %s %s',\n      to_char(ts AT TIME ZONE 'Asia/Seoul', 'YYYY-MM-DD HH24:MI:SS'), coalesce(consumer, '-'), coalesce(model, '-'), status,\n      coalesce(total_tokens::text, '-'), coalesce(prompt_tokens::text, '-'), coalesce(completion_tokens::text, '-'),\n      coalesce(latency_ms::text, '-'), coalesce(llm_latency_ms::text, '-'), coalesce(method, ''), coalesce(path, '')) AS \"내용\"\n  FROM requests WHERE request_id = ${rid:sqlstring}\n  UNION ALL\n  SELECT 2, '질문', coalesce(question, '(남지 않음 — 이 요청을 받은 대상은 Log payloads 가 꺼져 있었음)') FROM requests WHERE request_id = ${rid:sqlstring}\n  UNION ALL\n  SELECT 3, '답변', coalesce(answer, '(남지 않음)') FROM requests WHERE request_id = ${rid:sqlstring}\n) x ORDER BY o",
          "refId": "A"
        }
      ],
