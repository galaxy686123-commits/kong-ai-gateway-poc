{
  "uid": "kong-ai-gateway-poc",
  "title": "Kong AI Gateway PoC",
  "tags": [
    "kong",
    "ai-gateway",
    "poc"
  ],
  "editable": true,
  "schemaVersion": 39,
  "description": "요구사항 3-3 — 건수 · 토큰 · 비용은 요청 기록(DB, 한 건도 빠짐없이), 지연 · 라이선스는 Prometheus 지표. 모델 · 사용자별 사용량, 정책 차단, 게이트웨이 오버헤드와 LLM 지연, 시맨틱 캐시",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "요청 기록 — 질문 · 답변",
      "type": "link",
      "url": "/d/kong-poc-reqlog/request-log",
      "keepTime": true,
      "icon": "doc",
      "tooltip": "요청 한 건씩 — 사용자 · 모델 · 상태 · 질문 · 답변",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "tags": []
    }
  ],
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "embed",
        "label": "임베딩 모델",
        "hide": 2,
        "query": "__EMBED_MODEL__",
        "description": "LLM 패널에서 뺄 임베딩 모델 — start.sh 가 설정 파일의 DECK_EMBED_MODEL 로 채운다"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "개요 — 고른 기간",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "요청",
      "description": "고른 기간의 모든 요청 — 막힌 요청 포함 (요청 기록 기준 — 게이트웨이 내부 임베딩 호출은 뺌)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"요청\" FROM requests WHERE $__timeFilter(ts)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM 요청",
      "description": "LLM 이 답한 요청 (요청 기록 기준)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE model IS NOT NULL) AS \"LLM 요청\" FROM requests WHERE $__timeFilter(ts)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "토큰",
      "description": "질문 + 답변 토큰 (요청 기록 기준)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(total_tokens), 0) AS \"토큰\" FROM requests WHERE $__timeFilter(ts)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "오버헤드 p95",
      "description": "게이트웨이 오버헤드 — Kong 이 요청을 처리하느라 더한 시간(LLM 응답 시간은 뺌), 고른 기간의 95%",
      "datasource": {
        "type": "prometheus",
        "uid": "kong-poc-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kong-poc-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by(le)(increase(kong_kong_latency_ms_bucket{route!~\"grafana|ai-embed\"}[$__range])))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "차단 비율 (4xx)",
      "description": "고른 기간 요청 가운데 4xx(가드레일 · 인증 · 허용 그룹 · 한도)로 막힌 비율 (요청 기록 기준)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE status BETWEEN 400 AND 499) / greatest(count(*), 1) AS \"차단 비율\" FROM requests WHERE $__timeFilter(ts)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "라이선스 만료까지",
      "description": "Kong Enterprise 라이선스가 끝나기까지 남은 날",
      "datasource": {
        "type": "prometheus",
        "uid": "kong-poc-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 일",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 14
              },
              {
                "color": "green",
                "value": 45
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kong-poc-prometheus"
          },
          "expr": "(kong_enterprise_license_expiration - time())/86400",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "사용량 — 모델 · 사용자 (요청 기록 기준, 막대 하나 = 5분)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "모델별 LLM 요청 수 — 요청의 model 로 고른 결과",
      "description": "어느 모델이 답했는지. 목록 밖 이름이나 빈 model 은 기본 대상이 답한다. 막대를 누르면 그 모델의 요청 기록",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "interval": "5m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "links": [
            {
              "title": "이 모델의 요청 기록",
              "url": "/d/kong-poc-reqlog/request-log?var-model=${__field.name}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval, 0), model AS metric, count(*) AS v\nFROM requests\nWHERE $__timeFilter(ts) AND model IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "모델별 토큰 — 질문 · 답변",
      "description": "모델마다 질문(prompt) · 답변(completion) 토큰",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "interval": "5m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, metric, v FROM (\n  SELECT $__timeGroup(ts, $__interval, 0) AS time, model || ' · 질문' AS metric, sum(prompt_tokens) AS v\n  FROM requests WHERE $__timeFilter(ts) AND model IS NOT NULL GROUP BY 1, 2\n  UNION ALL\n  SELECT $__timeGroup(ts, $__interval, 0), model || ' · 답변', sum(completion_tokens)\n  FROM requests WHERE $__timeFilter(ts) AND model IS NOT NULL GROUP BY 1, 2\n) x ORDER BY 1",
          "refId": "A"
        }
      ]
    },
