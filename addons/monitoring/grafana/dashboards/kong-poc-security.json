          "rawSql": "SELECT coalesce(nullif(error_message, ''), '(사유 없음)') AS \"사유\", status AS \"상태 코드\",\n  left(string_agg(DISTINCT coalesce(route, '-'), ', '), 80) AS \"Route\",\n  left(string_agg(DISTINCT coalesce(consumer, '(Consumer 없음)'), ', '), 80) AS \"Consumer\",\n  count(*) AS \"건수\", max(ts) AS \"최근 발생\"\nFROM requests WHERE $__timeFilter(ts) AND status >= 400\nGROUP BY 1, 2 ORDER BY 5 DESC LIMIT 20"
