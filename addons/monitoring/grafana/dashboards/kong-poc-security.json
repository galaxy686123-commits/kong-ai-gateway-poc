      "title": "플러그인별 차단 · 마스킹 건수",
      "description": "막거나 가린 요청 수를 플러그인별로 표시",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kong-poc-reqlog"
      },
      "interval": "5m",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "stacking": {
