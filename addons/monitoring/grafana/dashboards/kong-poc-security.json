          "rawQuery": true,
          "rawSql": "WITH e AS (SELECT *, security_plugin(status, error_message, guardrail_block, masked_count, output_masked) AS plugin FROM requests WHERE $__timeFilter(ts))\nSELECT ts AS \"시각\",\n  CASE WHEN status >= 400 THEN '차단' ELSE '마스킹' END AS \"동작\",\n  plugin AS \"플러그인\",\n  coalesce(error_message, '') AS \"사유\",\n  coalesce(consumer, '-') AS \"Consumer\",\n  coalesce(end_user, '') AS \"최종 사용자(SSO)\",\n  coalesce(route, '-') AS \"Route\",\n  coalesce(workspace, 'default') AS \"Workspace\",\n  status AS \"상태 코드\",\n  coalesce(pii_labels(masked_types), '') AS \"마스킹 종류\",\n  masked_count AS \"마스킹 개수\",\n  output_masked AS \"답변 마스킹 개수\",\n  coalesce(guardrail_block, '') AS \"커스텀 가드레일\",\n  coalesce(client_ip, '') AS \"클라이언트 IP\",\n  coalesce(correlation_id, '') AS \"추적 ID\",\n  request_id\nFROM e\nWHERE plugin IS NOT NULL\n  AND ('__all' IN (${user:sqlstring}) OR coalesce(consumer, '-') IN (${user:sqlstring}))\n  AND ('__all' IN (${plugin:sqlstring}) OR plugin IN (${plugin:sqlstring}))\nORDER BY ts DESC\nLIMIT 500"
