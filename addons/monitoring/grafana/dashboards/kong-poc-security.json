          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kong-poc-reqlog"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH e AS (SELECT *, security_plugin(status, error_message, guardrail_block, masked_count, output_masked) AS plugin FROM requests WHERE $__timeFilter(ts))\nSELECT $__timeGroupAlias(ts, $__interval, 0), plugin AS metric, count(*) AS v FROM e\nWHERE plugin IS NOT NULL\n  AND ('__all' IN (${user:sqlstring}) OR coalesce(consumer, '-') IN (${user:sqlstring}))\n  AND ('__all' IN (${plugin:sqlstring}) OR plugin IN (${plugin:sqlstring}))\nGROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
