          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT CASE WHEN status = 400 THEN '400 가드레일 · 잘못된 요청' WHEN status = 401 THEN '401 인증 실패(키 · 토큰)' WHEN status = 403 THEN '403 접근 거부(ACL · 사용자 차단)' WHEN status = 404 THEN '404 Route 없음' WHEN status = 413 THEN '413 요청 크기 초과' WHEN status = 426 THEN '426 HTTPS 필요' WHEN status = 429 THEN '429 사용량 한도 초과' WHEN status = 503 THEN '503 서비스 불가(긴급 차단 · Upstream 장애)' WHEN status >= 500 THEN status || ' 서버 · LLM 오류' ELSE status || ' 기타' END AS \"유형\", count(*) AS \"건수\"\nFROM requests WHERE $__timeFilter(ts) AND status >= 400\nGROUP BY 1 ORDER BY 2 DESC"
        }
      ],
